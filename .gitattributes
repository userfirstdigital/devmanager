# Generated PWA artifacts are embedded and fingerprinted byte-for-byte.
web/bundle/** -text

# Vite's HTML entry transformation must receive the same bytes on Windows.
web/index.html text eol=lf

# Browser fixture payloads are asserted byte-for-byte on every platform.
tests/fixtures/browser-site/** text eol=lf

# Source-contract assertions must see the same Rust text on every platform.
*.rs text eol=lf
