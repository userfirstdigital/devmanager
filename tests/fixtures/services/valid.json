{
  "services": [
    {
      "id": "db",
      "scope": { "Task": { "task_id": "task-a" } },
      "command": {
        "program": "postgres",
        "args": ["-D", "data/db"],
        "cwd": "infra",
        "env": [{ "name": "DATABASE_PORT" }]
      },
      "dependencies": [],
      "health": {
        "Tcp": {
          "port": 5432,
          "policy": {
            "startup_deadline_ms": 5000,
            "probe_interval_ms": 1000,
            "max_probe_interval_ms": 4000,
            "backoff_multiplier": 2,
            "success_threshold": 2,
            "failure_threshold": 2,
            "stale_after_ms": 2500
          }
        }
      },
      "startup": { "trigger": "Manual", "restart_limit": 0 },
      "stop": { "graceful_timeout_ms": 1000, "kill_after_ms": 3000 },
      "expected_port": { "protocol": "Tcp", "port": 5432 }
    },
    {
      "id": "api",
      "scope": { "Task": { "task_id": "task-a" } },
      "command": {
        "program": "node",
        "args": ["server.js"],
        "cwd": "apps/api",
        "env": [{ "name": "PORT" }]
      },
      "dependencies": ["db"],
      "health": {
        "Tcp": {
          "port": 8080,
          "policy": {
            "startup_deadline_ms": 5000,
            "probe_interval_ms": 1000,
            "max_probe_interval_ms": 4000,
            "backoff_multiplier": 2,
            "success_threshold": 2,
            "failure_threshold": 2,
            "stale_after_ms": 2500
          }
        }
      },
      "startup": { "trigger": "Manual", "restart_limit": 0 },
      "stop": { "graceful_timeout_ms": 1000, "kill_after_ms": 3000 }
    }
  ]
}
